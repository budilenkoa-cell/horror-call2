
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>НЕ БЕРИ ТРУБКУ</title>
<style>
*{box-sizing:border-box}
body{
  margin:0;min-height:100vh;display:grid;place-items:center;
  background:#050505;color:#eee;font-family:Arial,sans-serif;
  text-align:center;padding:24px;overflow:hidden;
}
body:before{
  content:"";position:fixed;inset:0;pointer-events:none;
  background:repeating-linear-gradient(
    transparent 0px,rgba(255,0,0,.04) 2px,
    transparent 4px
  );
}
main{max-width:520px;position:relative}
h1{color:#e00018;letter-spacing:5px;font-size:clamp(28px,8vw,48px)}
#status{color:#aaa;min-height:48px;line-height:1.6}
button{
  padding:17px 26px;background:#9d0010;color:white;
  border:1px solid #ff273c;border-radius:4px;
  font-size:17px;cursor:pointer;
}
button:disabled{opacity:.5}
#screen{
  position:fixed;inset:0;background:#f00018;
  opacity:0;pointer-events:none;
}
.glitch{animation:glitch .13s steps(2) 5}
@keyframes glitch{
  0%{transform:translate(0)}
  25%{transform:translate(8px,-4px)}
  50%{transform:translate(-8px,3px)}
  75%{transform:translate(3px,6px)}
}
small{display:block;color:#666;margin-top:28px}
</style>
</head>
<body>
<div id="screen"></div>
<main>
  <h1>НЕ БЕРИ ТРУБКУ</h1>
  <p id="status">Неизвестный номер.<br>Одно пропущенное сообщение.</p>
  <button id="start">▶ ПРОСЛУШАТЬ СООБЩЕНИЕ</button>
  <small>Хоррор-история • Надень наушники</small>
</main>
<script>
const status = document.querySelector("#status");
const button = document.querySelector("#start");
const screen = document.querySelector("#screen");

let ctx, master, stopped = false;

function tone(freq, duration, volume, type="sine") {
  const osc = ctx.createOscillator();
  const gain = ctx.createGain();
  osc.type = type;
  osc.frequency.value = freq;
  gain.gain.setValueAtTime(0.001,ctx.currentTime);
  gain.gain.linearRampToValueAtTime(volume,ctx.currentTime+.2);
  gain.gain.exponentialRampToValueAtTime(
    0.001,ctx.currentTime+duration
  );
  osc.connect(gain);
  gain.connect(master);
  osc.start();
  osc.stop(ctx.currentTime+duration+.1);
}

function wait(ms) {
  return new Promise(resolve=>setTimeout(resolve,ms));
}

function speak(text) {
  return new Promise(resolve=>{
    if(!("speechSynthesis" in window)){
      status.textContent=text;
      setTimeout(resolve,3500);
      return;
    }
    speechSynthesis.cancel();
    const u = new SpeechSynthesisUtterance(text);
    u.lang="ru-RU";
    u.rate=.82;
    u.pitch=.72;
    u.volume=1;
    u.onend=resolve;
    u.onerror=resolve;
    speechSynthesis.speak(u);
    setTimeout(resolve,Math.max(7000,text.length*130));
  });
}

async function run() {
  button.disabled=true;
  stopped=false;
  ctx = new (window.AudioContext||window.webkitAudioContext)();
  await ctx.resume();
  master=ctx.createGain();
  master.gain.value=.18;
  master.connect(ctx.destination);

  tone(48,45,.15,"sawtooth");
  status.textContent="Соединение установлено...";
  await wait(2500);
  if(stopped)return;

  await speak("Алло... Ты меня слышишь?");
  await wait(1600);
  if(stopped)return;

  status.textContent="Входящее сообщение: 01:13";
  tone(110,5,.16,"sawtooth");
  await speak("Я звоню тебе уже третий раз. Почему ты не открываешь дверь?");
  await wait(1800);
  if(stopped)return;

  await speak("Странно... Я ведь вижу тебя через окно.");
  await wait(2200);
  if(stopped)return;

  status.textContent="ОШИБКА СОЕДИНЕНИЯ";
  tone(35,4,.3,"sawtooth");
  screen.style.opacity=".8";
  screen.classList.add("glitch");
  await wait(650);
  screen.style.opacity="0";
  await wait(800);
  if(stopped)return;

  await speak("Ладно. Посмотри за спину.");
  await wait(2200);
  if(stopped)return;

  // Резкий короткий звуковой эффект
  tone(75,.8,.9,"sawtooth");
  tone(900,.55,.5,"square");
  screen.style.opacity=".85";
  screen.classList.add("glitch");
  await wait(600);
  screen.style.opacity="0";
  screen.classList.remove("glitch");
  await wait(1500);

  if(stopped)return;
  await speak("Попался! Это всего лишь розыгрыш. Надеюсь, ты не испугался.");
  status.textContent="СООБЩЕНИЕ ПРОСЛУШАНО.";
  master.gain.setTargetAtTime(0,ctx.currentTime,.3);
  button.disabled=false;
  button.textContent="↻ ПРОСЛУШАТЬ ЕЩЁ РАЗ";
}

button.addEventListener("click",async()=>{
  if(stopped)return;
  try{await run();}
  catch(e){
    status.textContent="Не удалось запустить звук. Попробуй ещё раз.";
    button.disabled=false;
  }
});
</script>
</body>
</html>
